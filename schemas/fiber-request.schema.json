{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561:ptgae:fiber-request:0.2.0",
  "title": "PTGAE Fiber Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleVersion",
    "audience",
    "contentClass",
    "locale",
    "register",
    "claimStatus",
    "accessibilityProfile"
  ],
  "properties": {
    "bundleVersion": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "contentClass": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "register": {
      "enum": [
        "executive",
        "technical",
        "scientific",
        "legal-compliance",
        "public-service",
        "customer",
        "product",
        "media-editorial",
        "internal-operational"
      ]
    },
    "claimStatus": {
      "enum": [
        "Observed",
        "Measured",
        "Inferred",
        "Hypothesis",
        "Model",
        "Proposed",
        "Required",
        "Intended",
        "Simulated",
        "Unverified",
        "Disputed",
        "Deprecated",
        "Unknown"
      ]
    },
    "accessibilityProfile": {
      "type": "string",
      "minLength": 1
    },
    "terminologyVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "exceptionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "termResolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/termResolution"
      },
      "description": "Caller-asserted interpretations; may remain ambiguous or unresolved. Never evidence or office authority."
    }
  },
  "$defs": {
    "termReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termId",
        "sourceRevision"
      ],
      "properties": {
        "termId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "termResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "state"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "resolved",
            "ambiguous",
            "deprecated",
            "unresolved"
          ]
        },
        "canonicalId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "replacementId": {
          "type": "string",
          "minLength": 1
        },
        "readings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/termReading"
          }
        }
      }
    }
  }
}
