{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561:ptgae:fiber-request:0.2.1",
  "title": "PTGAE Fiber Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleVersion",
    "audience",
    "contentClass",
    "locale",
    "register",
    "claimStatus",
    "accessibilityProfile"
  ],
  "properties": {
    "bundleVersion": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "contentClass": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "description": "BCP47 syntax is checked with Intl.getCanonicalLocales; source fiber support is verified separately. Schema regex is not a substitute for locale negotiation."
    },
    "register": {
      "type": "string",
      "minLength": 1,
      "description": "Selector matches an actual register ID from the supplied source-owned registers.json fiber; no independently maintained enum."
    },
    "claimStatus": {
      "type": "string",
      "minLength": 1,
      "description": "Selector accepts source fiber claim-status ID (such as observed) or label (such as Observed) and preserves the chosen source status."
    },
    "accessibilityProfile": {
      "type": "string",
      "minLength": 1
    },
    "terminologyVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "exceptionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "termResolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/termResolution"
      },
      "description": "Caller-asserted interpretations; may remain ambiguous or unresolved. Never evidence or office authority."
    }
  },
  "$defs": {
    "termReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termId",
        "sourceRevision"
      ],
      "properties": {
        "termId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "termResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "state"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "resolved",
            "ambiguous",
            "deprecated",
            "unresolved"
          ]
        },
        "canonicalId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "replacementId": {
          "type": "string",
          "minLength": 1
        },
        "readings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/termReading"
          }
        }
      }
    }
  }
}
